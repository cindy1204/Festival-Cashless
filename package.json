{
  "name": "festival-cashless",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "nodemon --ext ts,json --exec 'tsx ./src/app.ts'",
    "sync": "npx prisma db pull && npx prisma generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:api",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:api": "tsx --test tests/http/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cindy1204/Festival-Cashless.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/cindy1204/Festival-Cashless/issues"
  },
  "homepage": "https://github.com/cindy1204/Festival-Cashless#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "express@5.2.1": true,
    "cors@2.8.6": true,
    "dotenv@17.4.2": true,
    "dotenv@18.0.4": true,
    "@prisma/client@7.10.0": true,
    "@prisma/adapter-pg@7.10.0": true,
    "pg@8.23.0": true
  }
}
