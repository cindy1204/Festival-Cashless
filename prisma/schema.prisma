generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model acreditaciones {
  id             Int         @id @default(autoincrement())
  nombre         String      @db.VarChar(100)
  medio          String      @db.VarChar(100)
  email          String      @db.VarChar(120)
  tipo           String      @db.VarChar(12)
  dia_id         Int
  escenario_id   Int?
  estado         String      @default("PENDIENTE") @db.VarChar(10)
  motivo_rechazo String?     @db.VarChar(300)
  state          String      @default("ACTIVE") @db.VarChar(20)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  dias           dias        @relation(fields: [dia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escenarios     escenarios? @relation(fields: [escenario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model artistas {
  id              Int               @id @default(autoincrement())
  nombre          String            @unique @db.VarChar(100)
  genero          String            @db.VarChar(60)
  pais            String            @db.VarChar(60)
  productos_merch productos_merch[]
  shows           shows[]
}

model asistentes {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(100)
  email                String                 @unique @db.VarChar(120)
  documento            String                 @unique @db.VarChar(20)
  fecha_nacimiento     DateTime               @db.Date
  boletas              boletas[]
  incidentes           incidentes[]
  inscripciones_meet   inscripciones_meet[]
  movimientos          movimientos[]
  objetos_perdidos     objetos_perdidos[]
  pedidos_comida       pedidos_comida[]
  resenas              resenas[]
  reservas_bus         reservas_bus[]
  reservas_camping     reservas_camping[]
  reservas_parqueadero reservas_parqueadero[]
  ventas_merch         ventas_merch[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model boletas {
  id           Int        @id @default(autoincrement())
  asistente_id Int
  dia_id       Int
  tipo         String     @db.VarChar(10)
  precio       Int
  state        String     @default("ACTIVE") @db.VarChar(20)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  asistentes   asistentes @relation(fields: [asistente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dias         dias       @relation(fields: [dia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model buses {
  id           Int            @id @default(autoincrement())
  ruta         String         @db.VarChar(100)
  dia_id       Int
  hora_salida  String         @db.VarChar(5)
  capacidad    Int
  estado       String         @default("PROGRAMADO") @db.VarChar(12)
  state        String         @default("ACTIVE") @db.VarChar(20)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  dias         dias           @relation(fields: [dia_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservas_bus reservas_bus[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dias {
  id                   Int                    @id @default(autoincrement())
  nombre               String                 @db.VarChar(40)
  fecha                DateTime               @unique @db.Date
  aforo                Int
  acreditaciones       acreditaciones[]
  boletas              boletas[]
  buses                buses[]
  incidentes           incidentes[]
  objetos_perdidos     objetos_perdidos[]
  reservas_parqueadero reservas_parqueadero[]
  shows                shows[]
  turnos               turnos[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model escenarios {
  id             Int              @id @default(autoincrement())
